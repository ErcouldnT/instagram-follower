# --- Instagram session -------------------------------------------------------
# Open instagram.com logged in, copy the whole `Cookie:` request header from
# devtools, and paste it here. Read at runtime, so rotating it is a restart.
IG_COOKIE="sessionid=...; ds_user_id=...; csrftoken=...; mid=...; ig_did=..."

# Optional: Instagram rotates its GraphQL query hashes. Override without a
# rebuild if scans start failing with "no follower data".
# IG_QUERY_HASH_FOLLOWING=
# IG_QUERY_HASH_FOLLOWERS=

# --- Storage -----------------------------------------------------------------
# SQLite file. In Docker this points at the mounted volume.
DATABASE_PATH=./data/app.db
# MIGRATIONS_PATH=./drizzle

# --- SvelteKit (adapter-node) ------------------------------------------------
# Required in production for CSRF origin checks to pass behind a proxy.
# ORIGIN=https://follower.example.com
# PORT=3000
