# --- Auth --------------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
# Required in production — the app refuses to start without it. Changing it
# signs every user out.
BETTER_AUTH_SECRET=

# --- Instagram session -------------------------------------------------------
# ONE session is shared by every account on this instance, which is why scans
# run one at a time in a queue rather than concurrently.
#
# Open instagram.com logged in, copy the whole `Cookie:` request header from
# devtools (or Cookie-Editor's "Export -> Header String"), and paste it here.
# Read at runtime, so rotating it is a restart rather than a rebuild.
IG_COOKIE="sessionid=...; ds_user_id=...; csrftoken=...; mid=...; ig_did=..."

# --- Storage -----------------------------------------------------------------
# SQLite file. In Docker this points at the mounted volume.
DATABASE_PATH=./data/app.db
# MIGRATIONS_PATH=./drizzle

# --- SvelteKit (adapter-node) ------------------------------------------------
# Required in production for CSRF origin checks and auth callbacks.
# ORIGIN=https://follower.example.com
# PORT=3000
